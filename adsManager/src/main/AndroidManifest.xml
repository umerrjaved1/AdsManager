<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!--
        No android:allowBackup here: a library manifest merges its application attributes into every
        consuming app, so declaring it silently overrode the host app's own backup policy.
    -->
    <application android:supportsRtl="true">

        <!--
            The ad-hosting Activity moved packages in the Next-Gen SDK; the legacy
            com.google.android.gms.ads.AdActivity no longer exists, so overriding it here would
            declare a class that is not on the classpath. The SDK ships this Activity itself with
            android:theme="@style/Theme.GoogleMobileAds" - the override below only swaps the theme,
            which is why tools:replace is still required.
        -->
        <activity android:name="com.google.android.libraries.ads.mobile.sdk.common.AdActivity"
            android:theme="@style/AdmobTheme"
            android:exported="false"
            tools:targetApi="33"
            tools:replace="android:theme" />

        <activity
            android:name="com.umer_tf.ads.domain.ads.native_ad.FullScreenNativeAdActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

    </application>


</manifest>