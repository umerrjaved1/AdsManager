<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15dp</item>
        <item name="android:text">"Ad"</item>
        <item name="android:padding">@dimen/_1sdp</item>
        <item name="android:background">@drawable/bg_square_yellow</item>
    </style>

    <!--
      Theme applied to the SDK's AdActivity via tools:replace in AndroidManifest.xml.

      It MUST inherit Theme.GoogleMobileAds. That theme is @android:style/Theme.Translucent plus
      windowNoTitle and transparent system bars, and the SDK's full-screen formats are drawn
      assuming it. This style used to be empty and parentless, which meant the tools:replace
      handed AdActivity a theme with no attributes at all - an opaque, titled window - instead of
      the translucent one Google ships. It exists only as an override hook for hosts; keep the
      parent on every variant of it.
    -->
    <style name="AdmobTheme" parent="@style/Theme.GoogleMobileAds"/>

</resources>