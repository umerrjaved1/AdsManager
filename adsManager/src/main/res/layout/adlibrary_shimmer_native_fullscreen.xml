<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <View
            android:id="@+id/ad_media_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ad_headline" />

        <View
            android:id="@+id/ad_headline"
            android:layout_width="220dp"
            android:layout_height="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ad_body_line1" />

        <View
            android:id="@+id/ad_body_line1"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ad_body_line2" />

        <View
            android:id="@+id/ad_body_line2"
            android:layout_width="260dp"
            android:layout_height="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ad_call_to_action" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
