<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_small_1c.xml (140dp square media left, icon + text right,
    full-width CTA below whichever column is taller).

    Mirrors the barrier from the ad layout, so the CTA sits where the ad will put it rather than
    directly under the media; the media is square here, not 140x100.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/adlibrary_shimmer_block"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ad"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/ad_text_badge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/ad_media_card"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/ad_media_radius"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/adlibrary_shimmer_block" />

        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_small"
            android:layout_height="@dimen/ad_icon_small"
            android:layout_marginStart="12dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter_semibold"
            android:lines="1"
            android:textSize="@dimen/ad_text_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_app_icon" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter"
            android:lines="2"
            android:textSize="@dimen/ad_text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_headline" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_media_or_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ad_media_card,ad_body,ad_headline" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrier_media_or_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
