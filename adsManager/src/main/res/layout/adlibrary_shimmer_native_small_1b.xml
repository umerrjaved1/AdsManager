<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_small_1b.xml (centred icon / headline / body / full-width CTA).

    Structural clone of that layout: same padding, ids, constraints and margins, and text blocks are
    TextViews carrying the real font, text size and line count, so the placeholder measures to the
    same height as the ad that replaces it instead of jumping.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/adlibrary_shimmer_block"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ad"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/ad_text_badge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp" />

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_large"
            android:layout_height="@dimen/ad_icon_large"
            android:layout_marginTop="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter_semibold"
            android:lines="1"
            android:textSize="@dimen/ad_text_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_app_icon" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter"
            android:lines="2"
            android:textSize="@dimen/ad_text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_headline" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
