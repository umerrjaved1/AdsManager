<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_small_4.xml (120x100 media left, icon + headline + badge row,
    body, CTA pinned to the bottom of the media).

    Structural clone of that layout, barrier and vertical bias included, so the CTA lands where the ad
    will put it. Media radius, icon size and CTA height come from the same dimens as the ad layout.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/ad_media_card"
            android:layout_width="120dp"
            android:layout_height="100dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/ad_media_radius"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/adlibrary_shimmer_block" />
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_small"
            android:layout_height="@dimen/ad_icon_small"
            android:layout_marginStart="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toTopOf="@id/ad_media_card" />

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="@string/ad"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/ad_text_badge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ad_media_card"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter_semibold"
            android:lines="1"
            android:textSize="@dimen/ad_text_headline"
            app:layout_constraintEnd_toStartOf="@id/ad_badge"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@id/ad_media_card" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ad_app_icon,ad_headline,ad_badge" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter"
            android:lines="2"
            android:textSize="@dimen/ad_text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/barrier_header" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="@id/ad_media_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_body"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
