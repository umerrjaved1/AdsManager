<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_large_v2.xml (16:9 media, icon overlapping it by -28dp, badge +
    rating row inset 72dp, headline, full-width CTA).

    Structural clone of that layout: same ConstraintLayout tree, ids, negative icon margin and row
    inset. The old version was a fixed 255dp LinearLayout with its own paddings and measured nothing
    like the ad.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/ad_media"
            android:layout_width="0dp"
            android:layout_height="144dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_large"
            android:layout_height="@dimen/ad_icon_large"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-28dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_media" />

        <LinearLayout
            android:id="@+id/info_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_media"
            tools:ignore="RtlSymmetry">

            <TextView
                android:id="@+id/ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/adlibrary_shimmer_block"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ad"
                android:textColor="@android:color/transparent"
                android:textSize="@dimen/ad_text_badge"
                tools:ignore="SmallSp" />

            <View
                android:id="@+id/ad_stars"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/adlibrary_shimmer_block" />

        </LinearLayout>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:lines="1"
            android:textSize="@dimen/ad_text_headline"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/info_row" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_headline" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
