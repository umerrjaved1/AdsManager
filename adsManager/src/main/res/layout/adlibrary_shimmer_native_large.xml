<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_large.xml (icon with badge + headline beside it, advertiser line,
    140dp media, full-width 53dp CTA).

    Structural clone of that layout: same ConstraintLayout tree, ids, margins and 8dp padding. The old
    LinearLayout version reserved a 150dp media and a 44dp CTA, so the slot resized twice on load.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:padding="4dp"
            android:text="@string/ad"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/ad_text_badge"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon"
            tools:ignore="SmallSp" />

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_large"
            android:layout_height="@dimen/ad_icon_large"
            android:layout_marginTop="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter_semibold"
            android:lines="1"
            android:textSize="@dimen/ad_text_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_badge"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:fontFamily="@font/inter"
            android:lines="1"
            android:textSize="@dimen/ad_text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toBottomOf="@id/ad_badge" />

        <View
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_body" />

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ad_media" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
