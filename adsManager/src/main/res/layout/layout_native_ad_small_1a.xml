<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- minHeight rather than a fixed 144dp: the text column is headline + badge + body + a 48dp CTA,
         which overflows a fixed height as soon as the system font scale goes up. -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/clAd" android:background="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="144dp"
        android:padding="12dp">

        <!-- Media View wrapped in CardView for rounded corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ad_media_card"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="@dimen/ad_media_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <!-- Headline -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:textColor="@color/ad_heading_color"
            android:textSize="@dimen/ad_text_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SadaPay: Money made si..." />

        <!-- AD Badge -->
        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/adlibrary_ad_badge_border"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ad"
            android:textColor="@color/ad_badge_text"
            android:textSize="@dimen/ad_text_badge"
            android:textStyle="bold"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            tools:ignore="SmallSp" />

        <!-- Body / Description -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="2"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="@dimen/ad_text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_badge"
            tools:text="Financial freedom, the Sada way! Make payments faster than you think." />

        <!-- Call to Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/cta_small_1a_shape"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/install"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/ad_text_cta"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@id/ad_media_card"
            app:layout_constraintTop_toBottomOf="@id/ad_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
