<?xml version="1.0" encoding="utf-8"?><!--
    Shimmer placeholder matching layout_native_ad_banner.xml, which is a fixed 130dp tall
    native banner (icon on the left, badge + headline + body, full-width CTA).
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:minHeight="130dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:id="@+id/ad_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/adlibrary_shimmer_block" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/ad_badge"
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:background="@drawable/adlibrary_shimmer_block" />

                <View
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/adlibrary_shimmer_block" />

                <View
                    android:id="@+id/ad_body_line1"
                    android:layout_width="160dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/adlibrary_shimmer_block" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/adlibrary_shimmer_block" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
