<?xml version="1.0" encoding="utf-8"?><!--
    Placeholder for layout_native_ad_small_3b.xml (icon, headline + trailing badge, body, CTA).

    Structural clone of that layout: same padding, ids, nesting and margins. The headline is
    wrap_content in the ad, so the placeholder pins a nominal width but takes its height from the real
    font and text size; the CTA reserves the same width via the same padding and label.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.95"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.35">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <View
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/ad_icon_large"
            android:layout_height="@dimen/ad_icon_large"
            android:background="@drawable/adlibrary_shimmer_block"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ad_cta_height"
            android:layout_marginStart="8dp"
            android:background="@drawable/adlibrary_shimmer_block"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/install"
            android:textColor="@android:color/transparent"
            android:textSize="@dimen/ad_text_cta"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ad_call_to_action"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/adlibrary_shimmer_block"
                    android:fontFamily="@font/inter_semibold"
                    android:lines="1"
                    android:textSize="@dimen/ad_text_headline" />

                <TextView
                    android:id="@+id/ad_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/adlibrary_shimmer_block"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="@string/ad"
                    android:textColor="@android:color/transparent"
                    android:textSize="@dimen/ad_text_badge"
                    android:textStyle="bold"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/adlibrary_shimmer_block"
                android:fontFamily="@font/inter"
                android:lines="1"
                android:textSize="@dimen/ad_text_body" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
