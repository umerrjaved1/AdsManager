<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad Operations &amp; Controls"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Interstitial Ads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interstitial Ad"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoadInterstitial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Load Interstitial"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnShowInterstitial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Show Interstitial"
                android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLoadAndShowInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Load &amp; Show Interstitial"
            android:textSize="12sp"/>

        <!-- Rewarded Ads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rewarded Ad"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoadRewarded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Load Rewarded"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnShowRewarded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Show Rewarded"
                android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLoadAndShowRewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Load &amp; Show Rewarded"
            android:textSize="12sp"/>

        <!-- App Open Ads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Open Ad"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoadAppOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Load App Open"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnShowAppOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Show App Open"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Banner Ads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banner Ads Section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- 1. Adaptive Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Adaptive Banner"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnShowAdaptiveBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; Show Adaptive Banner"
            android:textSize="11sp"/>

        <FrameLayout
            android:id="@+id/adContainer_adaptive_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <!-- 2. Medium Rectangle Banner (300x250) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Medium Rectangle Banner (300x250)"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnShowMemRecBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; Show Medium Rec Banner"
            android:textSize="11sp"/>

        <FrameLayout
            android:id="@+id/adContainer_memrec_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <!-- 3. Collapsible Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Collapsible Banner"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnShowCollapsibleBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; Show Collapsible Banner"
            android:textSize="11sp"/>

        <FrameLayout
            android:id="@+id/adContainer_collapsible_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <!-- Fullscreen Native Ad Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fullscreen Native Ad"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnShowFullscreenNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; Show Fullscreen Native"
            android:textSize="12sp"/>

        <FrameLayout
            android:id="@+id/adContainer_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="8dp"/>
        <include
            android:id="@+id/shimmerContainer_fullscreen"
            layout="@layout/adlibrary_shimmer_native_large_6a" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native Ad Small &amp; Large Variants"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!--
            The two ways to fill a screen full of native slots. Nothing loads until one is tapped, so
            whichever you press is the only thing that paid for the ads on screen.
        -->
        <Button
            android:id="@+id/btnNativeOneLoadAllShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One Load, All Show"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNativeAllLoadAllShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="All Load, All Show"
            android:textSize="12sp" />

        <!-- Variant 1a -->
        <TextView android:id="@+id/label_1a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 1a" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_1a" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 1b -->
        <TextView android:id="@+id/label_1b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 1b" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_1b" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 1c -->
        <TextView android:id="@+id/label_1c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 1c" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_1c" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 3a -->
        <TextView android:id="@+id/label_3a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 3a" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_3a" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 3b -->
        <TextView android:id="@+id/label_3b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 3b" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_3b" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 4 -->
        <TextView android:id="@+id/label_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 4" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_4" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 5a -->
        <TextView android:id="@+id/label_5a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 5a" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_5a" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 6a -->
        <TextView android:id="@+id/label_6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 6a" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_6a" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 6b -->
        <TextView android:id="@+id/label_6b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 6b" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_6b" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 7a -->
        <TextView android:id="@+id/label_7a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 7a" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_7a" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 7b -->
        <TextView android:id="@+id/label_7b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 7b" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_7b" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Variant 7c -->
        <TextView android:id="@+id/label_7c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Variant 7c" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
        <FrameLayout android:id="@+id/adContainer_7c" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>